// Cloudflare Workers: the built site in dist/ as static files, plus worker/index.js for the contact form.
// Secrets TURNSTILE_SECRET and CONTACT_TO are set in the Cloudflare dashboard, never in this file.
{
  "name": "portfolio",
  "compatibility_date": "2026-11-12",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "CONTACT_FROM": "formulier@thijmen.codes",
  },
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
  ],
}
