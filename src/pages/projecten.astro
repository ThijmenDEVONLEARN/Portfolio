---
import Page from '../layouts/Page.astro';

// repo: leave empty until the code is public; the link only shows when it is set.
const projects = [
  {
    title: 'Doelen-ideeën-canvas',
    live: true,
    text: 'Voor mensen met veel ideeën die ze moeilijk voor zich zien. Je maakt een hoofdidee en bouwt daaruit stappen: waar begin ik, hoe ziet het einddoel eruit en wat doe ik wanneer.',
    tags: ['Node.js', 'JavaScript'],
    repo: 'https://github.com/ThijmenDEVONLEARN/Doelen-ideen-canvas',
    slot: 'canvas',
    alt: 'Het Doelen-canvas: doelen als kaarten op een oneindig canvas, gegroepeerd per thema',
    img: '/images/canvas.webp',
  },
  {
    title: 'Persoonlijk dashboard',
    live: false,
    text: 'Eén rustige plek voor mijn agenda, taken, notities en geld, met een AI-assistent die meedenkt. Het voegt Google, Outlook en iCloud samen in één overzicht en draait op mijn eigen server. Claude schreef de code, ik bepaalde wat de app moest doen, hoe het eruitziet en wat veilig genoeg is.',
    tags: ['Node.js', 'TypeScript', 'PostgreSQL', 'React', 'Tauri'],
    repo: '',
    slot: 'dashboard',
    alt: 'Screenshot van het persoonlijk dashboard',
  },
  {
    title: 'Claude-brein',
    live: true,
    text: 'Een eigen geheugen voor Claude, op mijn eigen schijf. Claude onthoudt niets na een gesprek, en een map vol notities doorlezen kost veel. Mijn server geeft Claude eerst alleen korte samenvattingen en laat hem pas lezen wat hij echt nodig heeft. Zoeken blijft rond de 30 ms, gemeten op 300.000 notities, en alles is te bekijken als een heelal in de browser.',
    tags: ['TypeScript', 'Fastify', 'SQLite', 'MCP'],
    repo: 'https://github.com/ThijmenDEVONLEARN/claude-brain-open',
    slot: 'brein',
    alt: 'Het Claude-brein: notities als planetenstelsels in een heelal',
  },
];
---

<Page title="Projecten" description="Wat Thijmen gebouwd heeft. Alle code staat open op GitHub.">
  <div class="container">
    <div class="head">
      <h1>Wat ik gebouwd heb.</h1>
      <p class="lead">Open source, dus de code staat op GitHub. Hier de korte versie.</p>
    </div>
    <ol class="sec index ruled">
      {projects.map((p, i) => (
        <li>
          <div class="proj">
            <span class={p.live ? 'chip-ok' : 'chip-wip'}>
              {p.live ? 'Live op GitHub' : 'In ontwikkeling'}
            </span>
            <h2>{p.title}</h2>
            <p class="muted">{p.text}</p>
            {p.tags.length > 0 && (
              <ul class="tags">
                {p.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            )}
            {p.repo && <a href={p.repo}>Code op GitHub</a>}
          </div>
          <figure class="shot" data-slot={p.slot} data-alt={p.alt}>
            {p.img && (
              <img
                src={p.img}
                width="1440"
                height="900"
                alt={p.alt}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            )}
          </figure>
        </li>
      ))}
    </ol>
  </div>
</Page>
