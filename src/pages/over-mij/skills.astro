---
import Page from '../../layouts/Page.astro';

const levels = [
  {
    name: 'Dagelijks',
    filled: 3,
    text: 'Hier werk ik elke dag mee.',
    tags: ['HTML', 'CSS', 'JavaScript', 'Git'],
  },
  {
    name: 'Kan ik mee werken',
    filled: 2,
    text: 'Kan ik zelfstandig een opdracht mee doen.',
    tags: ['Astro', 'Node.js', 'SQL', 'C#'],
  },
  {
    name: 'Aan het leren',
    filled: 1,
    text: 'Ben ik nu mee bezig.',
    tags: ['n8n', 'three.js', 'Python'],
  },
];
---

<Page title="Skills" description="Wat Thijmen kan, eerlijk ingedeeld in drie niveaus.">
  <div class="container">
    <div class="head">
      <h1>Wat ik kan.</h1>
      <p class="lead">Eerlijk ingedeeld in drie niveaus. Geen procenten, want die zeggen niets.</p>
    </div>
    <ul class="sec levels">
      {levels.map((l) => (
        <li>
          <div class="levels__top">
            <small>niveau {l.filled} van 3</small>
            <h2>{l.name}</h2>
            <span class="meter" aria-hidden="true">
              {[1, 2, 3].map((n) => (
                <b class={n <= l.filled ? 'f' : undefined} />
              ))}
            </span>
            <p>{l.text}</p>
          </div>
          <ul>
            {l.tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
    <p class="muted small note-fill">Voorbeeldvulling. De echte lijst vul je later in.</p>
  </div>
</Page>
