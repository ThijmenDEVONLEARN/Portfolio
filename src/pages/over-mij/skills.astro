---
import Page from '../../layouts/Page.astro';

const levels = [
  {
    name: 'Dagelijks',
    filled: 3,
    text: 'Hier werk ik elke dag mee.',
    tags: ['HTML', 'CSS', 'Bootstrap', 'Tailwind'],
  },
  {
    name: 'Kan ik mee werken',
    filled: 2,
    text: 'Beheers ik nog niet helemaal, maar wel voldoende om mee te bouwen.',
    tags: ['JavaScript', 'C# en ASP.NET MVC', 'SQL en databases', 'PHP', 'TypeScript', 'Git'],
  },
  {
    name: 'Aan het leren',
    filled: 1,
    text: 'Ben ik nu mee bezig.',
    tags: ['React', 'Node.js', 'C#', 'Laravel'],
  },
];
---

<Page title="Skills" description="Wat Thijmen kan, eerlijk ingedeeld in drie niveaus.">
  <div class="container">
    <div class="head">
      <h1>Wat ik kan.</h1>
      <p class="lead">
        Ik weet al veel, maar beheers nog niet alles volledig. Daarom eerlijk ingedeeld in drie
        niveaus.
      </p>
    </div>
    <ul class="sec levels">
      {levels.map((l) => (
        <li>
          <div class="levels__top">
            <small>niveau {l.filled} van 3</small>
            <h2>{l.name}</h2>
            <span class="meter" aria-hidden="true">
              {[1, 2, 3].map((n) => (
                <b class={n <= l.filled ? 'f' : undefined} />
              ))}
            </span>
            <p>{l.text}</p>
          </div>
          <ul>
            {l.tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</Page>
