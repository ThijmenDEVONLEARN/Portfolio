---
import Page from '../../layouts/Page.astro';

const stops = [
  {
    when: 'Nu',
    title: 'Werken met AI',
    text: 'Samen met Claude leer ik hoe AI werkt: hoe je het gebruikt, hoe je een goede opdracht schrijft en welke tools er zijn.',
  },
  {
    when: 'Eigen werk',
    title: 'Open source projecten',
    text: 'Naast school bouw ik eigen projecten: een doelen-canvas, een persoonlijk dashboard en een eigen geheugen voor Claude.',
  },
  {
    when: 'Feb – jun 2026',
    title: 'Stage bij Barnhoorn ICT',
    text: "Websites gemaakt, bij klanten fouten opgelost en pc's opgehaald, en documentatie geschreven voor het bedrijf.",
  },
  {
    when: 'Sinds 2023',
    title: 'Bijbaan bij Aldi',
    text: 'Begonnen als medewerker, sinds juni eerste vervanger.',
  },
  {
    when: 'Aug 2023 – nu',
    title: 'Software Developer N4, ROC van Twente',
    text: 'In 2027 haal ik mijn diploma, met een examen en een afstudeerstage.',
  },
];
---

<Page
  title="Ervaring"
  description="De klim tot nu: opleiding, stage, eigen werk en wat Thijmen nu leert."
>
  <div class="container">
    <div class="head">
      <h1>De klim tot nu.</h1>
      <p class="lead">Van boven naar beneden: waar ik nu ben, en hoe ik hier kwam.</p>
    </div>
    <ol class="sec stops ruled" reversed>
      {stops.map((s) => (
        <li>
          <span class="shape" aria-hidden="true" />
          <span class="when">{s.when}</span>
          <div>
            <h2>{s.title}</h2>
            <p class="muted">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Page>
