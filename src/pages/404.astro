---
import Page from '../layouts/Page.astro';
---

<Page title="Pagina niet gevonden" description="Deze pagina bestaat niet.">
  <div class="container">
    <div class="head">
      <h1>Hier loopt het pad dood.</h1>
      <p class="lead">Deze pagina bestaat niet of is verhuisd. Kies een andere route.</p>
      <div class="actions actions--after">
        <a class="btn btn--primary" href="/">
          Terug naar de berg
        </a>
        <a class="btn" href="/projecten/">
          Bekijk mijn projecten
        </a>
      </div>
    </div>
  </div>
</Page>
