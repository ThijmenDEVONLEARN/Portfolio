---
import Page from '../layouts/Page.astro';

const services = [
  {
    title: 'Websites',
    text: 'Een website zoals jij hem wilt, of je bestaande site mooier gemaakt.',
    items: [
      'Ontwerp op maat',
      'Contactformulier dat in je mail binnenkomt',
      'Een nieuw design voor je site, de betaalpagina blijft zoals hij is',
      'Onderhoud na de oplevering',
      'Hulp bij hosting: ik zeg waar en hoe, jij maakt het aan',
    ],
    note: "Aan betaalpagina's kom ik niet: die bouw ik niet en die pas ik niet aan, ik verander alleen het design eromheen.",
  },
  {
    title: 'Kleine AI-workflows',
    text: 'Eenvoudige automatiseringen met AI en n8n die terugkerend werk van je overnemen.',
    items: ['Kleine, overzichtelijke klussen', 'Eerlijk vooraf of het lukt'],
    note: 'AI-workflows leer ik nog. Daarom neem ik alleen kleine klussen aan die ik goed kan afmaken.',
  },
];
const steps = [
  { title: 'Kennismaken', text: 'We bespreken wat je wilt, via een belletje of een berichtje.' },
  { title: 'Eerlijke offerte', text: 'Geen vaste prijzen, wel een duidelijk voorstel.' },
  {
    title: 'Bouwen',
    text: 'Ik maak de site en laat je tussendoor zien hoe het eruitziet, zodat je kunt bijsturen.',
  },
  {
    title: 'Opleveren',
    text: 'Als je tevreden bent, krijg je de site in een zip en leg ik uit waar en hoe je hem het beste kunt hosten.',
  },
];
---

<Page
  title="Diensten"
  description="Websites op maat en kleine AI-workflows, met een eerlijke offerte."
>
  <div class="container">
    <div class="head">
      <h1>Wat ik voor je kan maken.</h1>
      <p class="lead">
        Voor ondernemers en mensen die een mooie website of een slimme automatisering willen, zonder
        gedoe.
      </p>
    </div>
    <div class="sec svc">
      {services.map((s, i) => (
        <article class="card">
          <div class="entry__head">
            <span>Dienst {i + 1}</span>
          </div>
          <div class="entry__body">
            <h2>{s.title}</h2>
            <p>{s.text}</p>
            <ul>
              {s.items.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            <p class="svc__note">
              <strong>Eerlijk gezegd</strong>
              {s.note}
            </p>
          </div>
        </article>
      ))}
    </div>
    <section class="sec--l">
      <h2 class="sec-head">Zo gaat het</h2>
      <ol class="flow">
        {steps.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="actions actions--after">
        <a class="btn btn--primary" href="/contact/">
          Vraag een offerte aan
        </a>
      </div>
    </section>
  </div>
</Page>
