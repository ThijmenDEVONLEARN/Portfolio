---
import Page from '../layouts/Page.astro';

const services = ['Websites', 'Automatiseringen met n8n'];
const steps = [
  { title: 'Kennismaken', text: 'Voorlopige tekst.' },
  { title: 'Eerlijke offerte', text: 'Geen vaste prijzen, wel een duidelijk voorstel.' },
  { title: 'Bouwen', text: 'Voorlopige tekst.' },
  { title: 'Opleveren', text: 'Voorlopige tekst.' },
];
---

<Page title="Diensten" description="Websites en n8n-automatiseringen, met een eerlijke offerte.">
  <div class="container">
    <div class="head">
      <h1>Wat ik voor je kan maken.</h1>
      <p class="lead">Voorlopige tekst over voor wie je werkt.</p>
    </div>
    <div class="sec svc">
      {services.map((s, i) => (
        <article class="card">
          <div class="entry__head">
            <span>Dienst {i + 1}</span>
          </div>
          <div class="entry__body">
            <h2>{s}</h2>
            <p>Voorlopige tekst.</p>
            <ul>
              <li>Voorbeeld van wat je krijgt</li>
              <li>Voorbeeld</li>
              <li>Voorbeeld</li>
            </ul>
          </div>
        </article>
      ))}
    </div>
    <section class="sec honest">
      <h2>Eerlijk gezegd</h2>
      <p>
        Automatiseringen leer ik mezelf. De basis gaat goed, en ik zeg eerlijk wanneer iets nog
        buiten mijn kunnen ligt.
      </p>
    </section>
    <section class="sec--l">
      <h2 class="sec-head">Zo gaat het</h2>
      <ol class="flow">
        {steps.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="actions actions--after">
        <a class="btn btn--primary" href="/contact/">
          Vraag een offerte aan
        </a>
      </div>
    </section>
  </div>
</Page>
