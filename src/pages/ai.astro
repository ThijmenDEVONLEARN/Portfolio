---
import Page from '../layouts/Page.astro';

const wel = [
  'Code schrijven, terwijl ik bepaal wat er gebouwd wordt en hoe het eruitziet.',
  'Schetsen en varianten maken, zodat ik kan kiezen voordat er iets verandert.',
  'Fouten opsporen: ik test en meet op mijn eigen laptop, AI zoekt de oorzaak.',
  'Leren: ik vraag waarom iets zo werkt.',
];
const niet = [
  'Mijn eigen verhaal. De teksten over mij komen uit mijn eigen antwoorden.',
  'De eindbeslissing. Ik kies, test en zet het zelf live.',
];
const method = [
  { title: 'Zelf denken', text: 'Ik bepaal eerst wat ik wil en hoe het eruit moet zien.' },
  { title: 'Samen bouwen', text: 'AI schrijft de code, ik stuur bij met feedback en schetsen.' },
  {
    title: 'Controleren',
    text: 'Ik test het zelf, op mijn laptop en telefoon, en meet waar het hapert.',
  },
  {
    title: 'Begrijpen',
    text: 'Ik vraag waarom iets werkt, zodat ik het de volgende keer zelf kan.',
  },
];
---

<Page title="AI" description="Hoe Thijmen AI gebruikt als gereedschap, en waar niet voor.">
  <div class="container">
    <div class="head">
      <h1>AI als gereedschap.</h1>
      <p class="lead">
        Ik bouw samen met AI, en daar ben ik open over. Ik bepaal wat er gemaakt wordt, AI helpt me
        het sneller te bouwen.
      </p>
    </div>
    <section class="sec" data-switch>
      <div class="seg" role="tablist" aria-label="Waar ik AI wel en niet voor gebruik">
        <button role="tab" id="t-wel" aria-selected="true" aria-controls="ai-wel">
          Waar wel voor
        </button>
        <button role="tab" id="t-niet" aria-selected="false" aria-controls="ai-niet" tabindex="-1">
          Waar niet voor
        </button>
      </div>
      <div class="panel" role="tabpanel" id="ai-wel" aria-labelledby="t-wel">
        <ol class="uses ruled">
          {wel.map((w, i) => (
            <li>
              <span class="num">{i + 1}</span>
              {w}
            </li>
          ))}
        </ol>
      </div>
      <div class="panel" role="tabpanel" id="ai-niet" aria-labelledby="t-niet">
        <ol class="uses ruled">
          {niet.map((w, i) => (
            <li>
              <span class="num">{i + 1}</span>
              {w}
            </li>
          ))}
        </ol>
      </div>
    </section>
    <section class="sec--l">
      <h2 class="sec-head">Mijn werkwijze</h2>
      <ol class="method">
        {method.map((m) => (
          <li>
            <h3>{m.title}</h3>
            <p class="muted">{m.text}</p>
          </li>
        ))}
      </ol>
    </section>
    <div class="sec see see--narrow">
      <a href="/projecten/">
        Projecten <small>gemaakt met AI</small>
      </a>
    </div>
  </div>
</Page>

<script>
  // Tabs: without script both panels show in order.
  document.querySelectorAll('[data-switch]').forEach((sw) => {
    const tabs = [...sw.querySelectorAll<HTMLElement>('[role=tab]')];
    const pick = (t: HTMLElement) =>
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
      });
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(t));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        pick(n);
        n.focus();
      });
    });
    pick(tabs[0]);
  });
</script>
