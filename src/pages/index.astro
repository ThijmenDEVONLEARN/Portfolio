---
import Base from '../layouts/Base.astro';
import AboutIntro from '../components/AboutIntro.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/landing.css';
---

<Base title="Thijmen | websites en automatiseringen">
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;800&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Red+Hat+Display:wght@600&family=Red+Hat+Text:wght@400;500&family=Red+Hat+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </Fragment>
  <div class="track" id="track">
    <div class="stage">
      <!-- still of the first frame, shown until the 3D scene is ready -->
      <picture class="poster" aria-hidden="true">
        <source media="(orientation: portrait)" srcset="/images/berg-port.webp" />
        <img src="/images/berg-land.webp" alt="" fetchpriority="high" />
      </picture>
      <canvas id="gl" aria-hidden="true"></canvas>
      <div class="fallback" aria-hidden="true">
        <svg viewBox="0 0 800 400" preserveAspectRatio="xMidYMax slice">
          <path
            d="M0 400 L0 300 L180 250 L330 120 L420 60 L520 140 L640 110 L800 220 L800 400Z"
            fill="#2b3a28"
          />
          <path d="M380 95 L420 60 L465 100 L440 96 L420 110 L400 96Z" fill="#eef2f5" />
        </svg>
      </div>
      <div class="shade"></div>
      <nav aria-label="Hoofdmenu">
        <a class="nm" href="/">
          Thijmen
        </a>
        <span class="ln">
          <a href="/over-mij/">Over mij</a>
          <a href="/projecten/">Projecten</a>
          <a href="/diensten/">Diensten</a>
          <a class="w" href="/werk/">
            Open voor werk
          </a>
          <a class="c" href="/contact/">
            Contact
          </a>
        </span>
      </nav>
      <div class="copy">
        <h1>
          Thijmen<span>.</span>
        </h1>
        <div class="sub" id="sub">
          Ik bouw websites en automatiseringen. Scroll en klim mee.
        </div>
      </div>
      <div class="steps" id="dots" aria-hidden="true"></div>
      <div class="picker" role="group" aria-label="Accentkleur">
        <button data-a="oranje" aria-label="Oranje">
          <i style="background:#ff7a3d"></i>
        </button>
        <button data-a="ijs" aria-label="IJsblauw">
          <i style="background:#8fd0ff"></i>
        </button>
        <button data-a="amber" aria-label="Amber">
          <i style="background:#f3b648"></i>
        </button>
        <button data-a="rood" aria-label="Rood">
          <i style="background:#ff5a5f"></i>
        </button>
      </div>
      <div class="hint" id="hint">
        scroll om te klimmen ↓
      </div>
    </div>
  </div>

  <div class="home-intro">
    <AboutIntro heading="h2" />
    <nav class="next" aria-label="Volgende pagina">
      <div class="container">
        <a href="/over-mij/skills/">Verder naar Skills</a>
      </div>
    </nav>
    <SiteFooter />
  </div>

  <script>
    // load three.js only after the page has shown, so the first screen is not held up
    const start = () => import('../scripts/mountain.js');
    const later = () =>
      'requestIdleCallback' in window
        ? requestIdleCallback(start, { timeout: 1500 })
        : setTimeout(start, 200);
    if (document.readyState === 'complete') later();
    else addEventListener('load', later, { once: true });
  </script>
</Base>
