---
import Base from '../layouts/Base.astro';
import AboutIntro from '../components/AboutIntro.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/landing.css';
---

<Base title="Thijmen | websites en automatiseringen">
  <Fragment slot="head">
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </Fragment>
  <div class="track" id="track">
    <div class="stage">
      <!-- still of the first frame, shown until the scene is in -->
      <picture class="poster" aria-hidden="true">
        <source media="(orientation: portrait)" srcset="/images/berg-port.webp" />
        <img src="/images/berg-land.webp" alt="" fetchpriority="high" />
      </picture>
      <div id="seq" aria-hidden="true"></div>
      <div class="shade"></div>
      <nav aria-label="Hoofdmenu">
        <a class="nm" href="/">
          Thijmen
        </a>
        <span class="ln">
          <a href="/over-mij/">Over mij</a>
          <a href="/projecten/">Projecten</a>
          <a href="/diensten/">Diensten</a>
          <a class="w" href="/werk/">
            Open voor werk
          </a>
          <a class="c" href="/contact/">
            Contact
          </a>
        </span>
      </nav>
      <div class="copy">
        <h1>
          Thijmen<span>.</span>
        </h1>
        <div class="sub" id="sub">
          Ik bouw websites en automatiseringen. Scroll en klim mee.
        </div>
      </div>
      <div class="steps" id="dots" aria-hidden="true"></div>
      <div class="hint" id="hint">
        scroll om te klimmen ↓
      </div>
      <div class="gate" id="gate" role="status">
        <div class="gate-card">
          <span class="gate-ring" aria-hidden="true">
            <svg viewBox="0 0 64 64">
              <circle cx="32" cy="32" r="28"></circle>
              <circle cx="32" cy="32" r="28"></circle>
            </svg>
            <b>2</b>
          </span>
          <p>
            <strong>Scroll rustig omhoog</strong>
            De berg klimt met je mee. Je kunt zo beginnen.
          </p>
          <span class="gate-mouse" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </div>

  <div class="home-intro">
    <AboutIntro heading="h2" />
    <nav class="next" aria-label="Volgende pagina">
      <div class="container">
        <a href="/over-mij/skills/">Verder naar Skills</a>
      </div>
    </nav>
    <SiteFooter />
  </div>

  <script>
    import '../scripts/frames.js';
  </script>
</Base>
