---
import Page from '../layouts/Page.astro';

const wishes = [
  ['Soort werk', 'Bijbaan als developer of een afstudeerstage'],
  ['Uren', '16 uur per week'],
  [
    'Wanneer',
    'Bijbaan: na school, vanaf half 3 of half 4, afhankelijk van mijn rooster. Stage: hele dagen, want stage valt onder school en daar krijg ik vrij voor.',
  ],
  ['Regio', 'Het liefst Hengelo, Enschede of Oldenzaal kan ook'],
];
---

<Page
  title="Werk"
  description="Thijmen is open voor werk. Wat hij zoekt en waar je verder kunt kijken."
>
  <div class="container">
    <div class="head">
      <h1>Op zoek naar een team.</h1>
      <p class="lead">
        Ik werk hard, wil elke dag bijleren, gebruik AI op een verstandige manier en ken de basis
        van programmeren.
      </p>
    </div>
    <div class="sec work">
      <article class="card">
        <div class="entry__head">
          <span>Wat ik zoek</span>
          <span class="chip-ok">Open voor werk</span>
        </div>
        <dl>
          {wishes.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
      </article>
      <div class="see">
        <h2 class="visually-hidden">Bekijk eerst</h2>
        <a href="/over-mij/skills/">
          Skills <small>wat ik kan</small>
        </a>
        <a href="/projecten/">
          Projecten <small>wat ik maakte</small>
        </a>
        <a href="/contact/">
          Contact <small>laten we praten</small>
        </a>
      </div>
    </div>
  </div>
</Page>
